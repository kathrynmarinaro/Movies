# --- secrets -----------------------------------------------------------
# Real credentials live here: the DB password, the admin password hash, the
# TMDB API key and the cron token. config.example.php is the tracked template.
config.php

# --- cached posters ----------------------------------------------------
# Downloaded from TMDB on first fetch and cached forever. These are fetched
# data, not source — a fresh checkout re-fetches them.
#
# MANUALLY UPLOADED POSTERS ARE THE EXCEPTION. A movie TMDB doesn't have
# carries a poster that exists nowhere else, and nothing can re-fetch it.
# Back this directory up before wiping it.
public/posters/*
!public/posters/.gitkeep

# NOT the deny file. `public/posters/*` above matches dotfiles too, so without
# this line the .htaccess that stops PHP executing in the one directory the app
# writes uploaded bytes into is never committed — and therefore never deployed.
# It would be missing on the server with nothing to indicate it, which is the
# worst way for a security control to be absent.
!public/posters/.htaccess

# --- agent worktrees ---------------------------------------------------
# Claude Code creates a git worktree per parallel agent in here. They're live
# working directories with their own branches, not source. Only worktrees/ is
# ignored, so genuine project config under .claude/ stays tracked.
.claude/worktrees/

# --- deployment / local ------------------------------------------------
# Bundles built for uploading to Hostinger
*.zip

.DS_Store
*.log
